# ─── Supabase ─────────────────────────────────────────────────────────────
# From: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://ggccdjxthuvthoqaxsoy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# SERVICE ROLE KEY — bypasses RLS. NEVER expose to the browser.
# Used only in /app/api/* and middleware.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── App ──────────────────────────────────────────────────────────────────
# Set to 'true' for local development to bypass the IP allowlist.
# In production this MUST be 'false' or unset.
DEV_BYPASS_IP_ALLOWLIST=true

# Used to bootstrap reminders, not enforced anywhere.
INITIAL_ADMIN_EMAIL=admin@yourcompany.com
